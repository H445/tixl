{
  "Id": "7f3e4d8a-9b2c-4a1f-8e5d-3c7b2a9d1f6e"/*SoundtrackClip*/,
  "Description": "A timeline-integrated audio clip player that works exactly like TimeClip but with added audio features. The clip can be positioned, stretched, and styled on the timeline like any other TimeClip, while providing:\n\n- [Timeline Display]: Appears directly on timeline for visual editing\n- [Audio Playback]: Routes through the global soundtrack mixer\n- [Volume Control]: Independent per-clip volume adjustment\n- [Stereo Panning]: Position audio in stereo field\n- [Speed Control]: Playback speed multiplier with timeline synchronization\n- [Waveform Display]: Future support for visual audio waveform on timeline (planned)",
  "InputUis": [
    {
      "InputId": "a3f7c1e8-5d2b-4a9f-1c6e-2b8a3f5d7c1e"/*Mute*/,
      "Position": {
        "X": -200.0,
        "Y": 250.0
      },
      "Description": "When enabled, mutes the audio output without stopping playback"
    },
    {
      "InputId": "b8e2f1a9-4d7c-4e5b-a2f3-8c6d1e9a4b7f"/*Volume*/,
      "Position": {
        "X": -200.0,
        "Y": 100.0
      },
      "Description": "Audio output volume level (0.0 to 2.0+)",
      "Min": 0.0,
      "Max": 2.0,
      "Scale": 0.01,
      "ClampMin": true
    },
    {
      "InputId": "c4a1d5e2-8f3b-4c6a-9e1d-7b2a5f8c3d4e"/*AudioFile*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Path to the audio file to play on the timeline",
      "Usage": "FilePath",
      "FileFilter": "mp3, wav, ogg, flac"
    },
    {
      "InputId": "e1c7b4a2-8f5d-4a3e-2c6f-1a9b8e3d5f2c"/*Speed*/,
      "Position": {
        "X": -200.0,
        "Y": 200.0
      },
      "Description": "Playback speed multiplier (affects pitch). Must be greater than 0",
      "Min": 0.1,
      "Max": 4.0,
      "Scale": 0.01,
      "ClampMin": true
    },
    {
      "InputId": "f2d8a5c1-3e4b-4f6a-8c1d-9e7a2b5f3c6a"/*Panning*/,
      "Position": {
        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Stereo panning position (-1.0 = left, 0.0 = center, 1.0 = right)",
      "Min": -1.0,
      "Max": 1.0,
      "Scale": 0.001,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "OutputUis": [
    {
      "OutputId": "b1e9d4f7-3a8c-4b2f-6e5d-1c9a7f3e2b8a"/*Output*/,
      "Position": {
        "X": 200.0,
        "Y": 0.0
      },
      "Description": "Timeline clip output. The clip position and duration can be edited directly on the timeline. Appears as an audio track with waveform visualization (planned)."
    }
  ]
}
