{
  "FormatVersion": 3,
  "Id": "f435a3e2-9d1d-55c7-b3a8-006cbe4f0f16",
  "Description": "Draw a TiXL PBR mesh with GPU triangle-frustum filtering in the active camera. No region table is required. The stock PBR shader reads the original vertices in source face order. BypassCulling compares against the full draw.",
  "SymbolTags": "1",
  "InputUis": [
    {"InputId": "fc2f9242-4c2c-4df3-bda2-f3b8d9638806", "Position": {"X": -320, "Y": 890}, "Description": "Build a private depth prepass for opaque geometry."},
    {
      "InputId": "eb6969c1-d8eb-5672-9e20-66f68e475e3b",
      "Position": {
        "X": 1526.489,
        "Y": 3627.165
      },
      "Description": "Default: uses the mesh normals.\nFlat: computes facet normals per pixel, giving a faceted look."
    },
    {
      "InputId": "d37aca8e-d24f-5767-8fc6-06b240c69e5f",
      "Position": {
        "X": 2089.872,
        "Y": 3905.177
      },
      "GroupTitle": "Texture Options",
      "Description": "Texture filtering mode."
    },
    {
      "InputId": "c08454db-64fd-5e30-a6b2-6d8981dc3be4",
      "Position": {
        "X": 2404.7104,
        "Y": 4099.43
      },
      "GroupTitle": "Draw Style",
      "Description": "Solid or wireframe rendering."
    },
    {
      "InputId": "e3b16858-ed02-5f46-a03a-9c4bddd212d7",
      "Position": {
        "X": 1778.2278,
        "Y": 3092.3406
      },
      "GroupTitle": "Field Overrides...",
      "Description": "Optional field whose color is multiplied with each fragment, evaluated at the world position.\n\nTry [SphereSDF] -> [SDFToColor] -> FragmentField."
    },
    {
      "InputId": "fb00642d-7aeb-5a0f-85d2-58e3abf89205",
      "Position": {
        "X": 1824.954,
        "Y": 3585.8855
      },
      "Description": "Fragments with an alpha below this value are discarded. 0 disables alpha testing."
    },
    {
      "InputId": "5eb9f991-4b3e-5d9c-8081-af046eef0d26",
      "Position": {
        "X": 1544.9539,
        "Y": 3445.8855
      },
      "GroupTitle": "Appearance",
      "Description": "Tints the mesh. Multiplied with the material colors set by [SetMaterial]."
    },
    {
      "InputId": "bdc908d0-c516-5a2e-91b5-1b05e7174447",
      "Position": {
        "X": 1778.2278,
        "Y": 3127.3406
      },
      "Description": "Additional HLSL code inserted into the generated shader, e.g. #define statements or helper functions. Invalid code breaks rendering.",
      "Usage": "Multiline"
    },
    {
      "InputId": "5eaa034a-fe2f-5836-978b-8052078ece41",
      "Relevancy": "Required",
      "Position": {
        "X": 1339.876,
        "Y": 3887.7703
      }
    },
    {
      "InputId": "0b2ab808-5666-52d5-b80f-6cc5032e176b",
      "Position": {
        "X": 2404.7104,
        "Y": 4175.523
      }
    },
    {
      "InputId": "a3b701c9-5107-535b-a397-c9c1be4e1401",
      "Position": {
        "X": 2404.7104,
        "Y": 4064.43
      },
      "Description": "Which faces are hidden.\n\nNone: both sides are drawn.\nFront: front faces are hidden, only back faces are visible.\nBack: back faces are hidden (default)."
    },
    {
      "InputId": "614e7f3b-2003-5705-ba0c-ae2cceea05f4",
      "Position": {
        "X": 2404.7104,
        "Y": 4210.523
      },
      "Description": "If enabled, fragments hidden behind already drawn geometry (according to the depth buffer) are discarded.",
      "AddPadding": "True"
    },
    {
      "InputId": "ddd65751-ccd5-5ccb-ab0a-99cc0c57da0f",
      "Position": {
        "X": 1824.9539,
        "Y": 3655.8855
      },
      "Description": "Reduces specular aliasing on silhouettes and in high-frequency normal map regions.",
      "Min": 0.0,
      "Max": 20.0,
      "ClampMin": true
    },
    {
      "InputId": "33b3bd12-e4fd-52d0-96ca-7371407624c7",
      "Position": {
        "X": 2039.8054,
        "Y": 4026.683
      },
      "Description": "How the texture is sampled outside the 0..1 UV range.\n\nWrap: repeats.\nMirror: repeats mirrored.\nClamp: extends the edge pixels.\nBorder: uses the sampler border color.\nMirrorOnce: mirrors once, then clamps."
    },
    {
      "InputId": "d2927e15-e9d6-5eb3-b5ac-095d95113c5e",
      "Position": {
        "X": 2404.7104,
        "Y": 4245.523
      },
      "Description": "If enabled, the mesh writes into the depth buffer so it can occlude itself and geometry drawn later."
    },
    {
      "InputId": "b9142068-e4a8-558b-a3cb-8b2583dfba5f",
      "Description": "Draw the complete mesh for a same-camera comparison.",
      "Position": {
        "X": -900,
        "Y": 670
      }
    },
    {
      "InputId": "a5be3978-7ef0-53f4-a20e-298c11ffadf3",
      "Description": "Use for fixed local positions and topology. Reuse bounds for groups of 128 triangles as the camera or object moves. Matching views can reuse the previous submission. Leave off for meshes rewritten on the GPU.",
      "Position": {
        "X": -900,
        "Y": 732
      }
    }
  ],
